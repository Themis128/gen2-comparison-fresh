# AWS Amplify Environment Variables
# Copy this file to .env.local and replace with your actual values

# Google OAuth Configuration
# Get these from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub OAuth Configuration
# Get these from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Google Analytics (optional)
# Get from: https://analytics.google.com/
NEXT_PUBLIC_GA_MEASUREMENT_ID=your_ga_measurement_id_here

# reCAPTCHA Configuration
# Get from: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# External Contact API (optional)
# If you want to use external API instead of Amplify GraphQL
CONTACT_FORM_API_URL=https://your-api-endpoint.com/contact

# Build Optimization (recommended)
NEXT_TELEMETRY_DISABLED=1
NODE_OPTIONS=--max-old-space-size=20480

# Sentry Error Monitoring & Analytics
# Get these values from your Sentry project settings at https://sentry.io/settings/projects/
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug

# Optional: Sentry Auth Token for source map uploads (only needed for production builds)
# Get from: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=your-auth-token
