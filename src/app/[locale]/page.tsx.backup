import dynamic from 'next/dynamic';
import { Metadata } from 'next';

// Dynamic imports for client components
const Hero = dynamic(() => import('@/components/Hero'), {
  loading: () => <div className="h-32 animate-pulse rounded-lg bg-muted" />,
});
const About = dynamic(() => import('@/components/About'), {
  loading: () => <div className="h-32 animate-pulse rounded-lg bg-muted" />,
});
const Skills = dynamic(() => import('@/components/Skills'), {
  loading: () => <div className="h-32 animate-pulse rounded-lg bg-muted" />,
});
const ContactMessages = dynamic(() => import('@/components/ContactMessages'), {
  loading: () => <div className="h-32 animate-pulse rounded-lg bg-muted" />,
});
// Generate metadata for SEO
export async function generateMetadata(): Promise<Metadata> {
  // Dynamic import to get personalData as plain object
  const { personalData } = await import('@/lib/personal-data');
  
  const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: personalData.name,
    jobTitle: personalData.title,
    description: personalData.bio,
    url: personalData.website,
    sameAs: [personalData.twitter, personalData.linkedin, personalData.github].filter(Boolean),
    address: {
      '@type': 'PostalAddress',
      addressLocality: personalData.location,
    },
    email: personalData.email,
    telephone: personalData.phone,
    knowsAbout: personalData.skills,
    hasOccupation: {
      '@type': 'Occupation',
      name: personalData.title,
      occupationLocation: {
        '@type': 'City',
        name: personalData.location,
      },
    },
  };

  return {
    title: `${personalData.name} | ${personalData.title}`,
    description: personalData.bio,
    keywords: ['portfolio', 'developer', 'software engineer', ...personalData.skills],
    authors: [{ name: personalData.name }],
    creator: personalData.name,
    publisher: personalData.name,
    openGraph: {
      title: `${personalData.name} | ${personalData.title}`,
      description: personalData.bio,
      type: 'profile',
      url: personalData.website,
    },
    twitter: {
      card: 'summary_large_image',
      title: `${personalData.name} | ${personalData.title}`,
      description: personalData.bio,
      creator: personalData.twitter?.split('/').pop(),
    },
    other: {
      'application/ld+json': JSON.stringify(jsonLd),
    },
  };
}

export default async function HomePage() {
  // Dynamic import to get personalData as plain object that can be serialized
  const { personalData } = await import('@/lib/personal-data');
  
  console.log('HomePage: personalData loaded:', personalData?.name);
  console.log("About to return JSX");
  
  // Create plain objects from personalData properties to avoid module serialization issues
  const heroData = {
    name: personalData.name,
    title: personalData.title,
    bio: personalData.bio,
    location: personalData.location,
    email: personalData.email,
    phone: personalData.phone,
    website: personalData.website,
    twitter: personalData.twitter,
    linkedin: personalData.linkedin,
    github: personalData.github,
  };
  
  const aboutData = {
    bio: personalData.bio,
    experience: personalData.experience,
    education: personalData.education,
    certifications: personalData.certifications,
  };
  
  const skillsData = {
    skills: personalData.skills,
    technologies: personalData.technologies,
  };
  
  return (
    <main className="min-h-screen">
      <Hero data={heroData} />
      <About data={aboutData} />
      <Skills data={skillsData} />
      {/* Portfolio Management Tools */}
      <ContactMessages />
    </main>
  );
}
